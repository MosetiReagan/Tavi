<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up settings only; omit private databases, documents, and model weights. -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Apply the same settings-only policy to device transfers. -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
