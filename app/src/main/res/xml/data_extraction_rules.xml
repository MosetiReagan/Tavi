<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include user preferences and application settings -->
        <include domain="sharedpref" path="." />

        <!-- Strictly exclude private on-device SQLite memory and conversation history from remote cloud backups -->
        <exclude domain="database" path="tavi.db" />
        <exclude domain="database" path="tavi.db-wal" />
        <exclude domain="database" path="tavi.db-shm" />
        <exclude domain="database" path="tavi_local.db" />

        <!-- Strictly exclude large multi-gigabyte re-downloadable neural model weights -->
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="litertlm/" />
        <exclude domain="root" path="files/models" />
    </cloud-backup>

    <device-transfer>
        <!-- Allow direct encrypted local device-to-device transfers if explicitly initiated by user -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="tavi.db" />
        <!-- Still exclude bulky model weights which can be re-downloaded -->
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="litertlm/" />
    </device-transfer>
</data-extraction-rules>
